# Storage — https://upstash.com or Vercel's built-in Redis storage
# Without one of these set, the app falls back to an in-memory store that
# resets on every server restart / serverless instance. Fine for local dev,
# required before deploying.

# Option A: REST API credentials (Upstash direct, or the older Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B: standard connection string (Vercel's native "Redis" storage
# product sets this automatically when connected to the project)
REDIS_URL=
